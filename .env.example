# Local: copy this file to .env
# Railway: set the same values in Variables. Do not upload real keys.

PORT=8080
CWA_API_KEY=

TARGET_LAT=22.705864872692686
TARGET_LON=120.33468473266137

# Node checks CWA metadata at startup, then every N minutes.
# It downloads GRIB2 only when InitialTime changes.
WRF_REFRESH_MINUTES=60

# O-B0045-001 past-1h QPE product updates about every 10 minutes.
QPE_REFRESH_MINUTES=10

# QPE freshness safety:
# <=30 min normal, 30-60 min warning, >60 min stop using for judgement.
QPE_WARN_MINUTES=30
QPE_EXPIRE_MINUTES=60

# In-memory proxy cache for identical CWA requests.
CWA_PROXY_CACHE_MS=120000

# Local default can be omitted (= ./data).
# Railway with a Volume mounted at /data: set DATA_DIR=/data
DATA_DIR=./data

PYTHON_BIN=python3

# Optional. If set, POST /api/wrf/refresh requires x-admin-token.
ADMIN_TOKEN=


# Experimental: direct CWA GFS 0.25° GRIB2.
# First run: npm run gfs:cwa:probe
# Only enable background updates after probe says usable_for_5day=true.
CWA_GFS_ENABLED=false
CWA_GFS_REFRESH_MINUTES=360
